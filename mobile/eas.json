{
  "cli": { "version": ">= 12.0.0" },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": { "EXPO_PUBLIC_API_BASE_URL": "http://localhost:3000", "EXPO_PUBLIC_WS_BASE_URL": "ws://localhost:3000" }
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://sportapp-api.onrender.com",
        "EXPO_PUBLIC_WS_BASE_URL": "wss://sportapp-api.onrender.com"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://sportapp-api.onrender.com",
        "EXPO_PUBLIC_WS_BASE_URL": "wss://sportapp-api.onrender.com"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
